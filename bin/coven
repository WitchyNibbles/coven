#!/bin/sh
# Runs the coven CLI on the python3 found on PATH. Works through symlinks.

if ! python=$(command -v python3); then
    echo "coven: python3 not found on PATH (needs Python 3.12 or later)" >&2
    exit 1
fi

version=$("$python" -c 'import platform; print(platform.python_version())' 2>/dev/null)
major=${version%%.*}
rest=${version#*.}
minor=${rest%%.*}
case "$major.$minor" in
    *[!0-9.]* | .* | *. | "")
        ok=no ;;
    *)
        if [ "$major" -gt 3 ] || { [ "$major" -eq 3 ] && [ "$minor" -ge 12 ]; }; then ok=yes; else ok=no; fi ;;
esac
if [ "$ok" != yes ]; then
    echo "coven: needs Python 3.12 or later, found ${version:-nothing} at $python" >&2
    exit 1
fi

# The real path of this script ($0 may be a symlink, or a chain of them) locates src/.
exec "$python" -I -c '
import os
import sys

root = os.path.dirname(os.path.dirname(os.path.realpath(sys.argv[1])))
sys.path.insert(0, os.path.join(root, "src"))
from coven.cli import main

sys.exit(main(sys.argv[2:]))
' "$0" "$@"
