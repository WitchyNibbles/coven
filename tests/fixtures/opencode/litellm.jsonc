{
  "update": "disable",
  "model": "litellm/big",
  "agents": {
    "explorer": {
      "model": "litellm/small"
    },
    "implementer": {
      "model": "litellm/big"
    },
    "reviewer": {
      "model": "litellm/big"
    },
    "final-reviewer": {
      "model": "litellm/big"
    },
    "title": {
      "model": "litellm/small"
    }
  },
  "providers": {
    "litellm": {
      "name": "LiteLLM",
      "package": "@opencode/ai/providers/openai-compatible",
      "env": [
        "GATEWAY_KEY"
      ],
      "settings": {
        "baseURL": "http://127.0.0.1:4000/v1"
      },
      "models": {
        "big": {
          "name": "big"
        },
        "small": {
          "name": "small"
        }
      }
    }
  },
  "plugins": [
    {
      "package": "<P>/plugin/coven",
      "options": {
        "covenRoot": "<COVEN_ROOT>",
        "keyEnv": "GATEWAY_KEY",
        "toolChoiceAuto": [
          "litellm"
        ],
        "guardTimeoutMs": 5000
      }
    }
  ],
  "experimental": {
    "todo": true
  },
  "permissions": [
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.example",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "<P>/config/opencode/skills/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "<STORE>/*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "<P>/config/opencode/skills/*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "ask"
    }
  ]
}
