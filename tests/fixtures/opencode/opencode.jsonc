{
  "update": "disable",
  "model": "opencode/big",
  "agents": {
    "explorer": {
      "model": "opencode/big"
    },
    "implementer": {
      "model": "opencode/big"
    },
    "reviewer": {
      "model": "opencode/big"
    },
    "final-reviewer": {
      "model": "opencode/big"
    },
    "title": {
      "model": "opencode/big"
    }
  },
  "plugins": [
    {
      "package": "<P>/plugin/coven",
      "options": {
        "covenRoot": "<COVEN_ROOT>",
        "keyEnv": "OPENCODE_API_KEY",
        "toolChoiceAuto": [],
        "guardTimeoutMs": 5000
      }
    }
  ],
  "experimental": {
    "todo": true
  },
  "permissions": [
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.example",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "<P>/config/opencode/skills/*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "<P>/config/opencode/skills/*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "ask"
    }
  ]
}
